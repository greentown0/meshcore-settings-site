<!doctype html>
<html lang="{{ lang | default('en') }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Primary meta -->
  <title>{{ seo_title | default(title) }}</title>
  <meta name="description" content="{{ description }}">

  <!-- Canonical & hreflang (absolute URLs required by Google) -->
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" hreflang="en" href="{{ site.url }}/en/">
  <link rel="alternate" hreflang="nl" href="{{ site.url }}/nl/">
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}/en/">

  <!-- Open Graph -->
  <meta property="og:type"        content="website">
  <meta property="og:site_name"   content="{{ brand }}">
  <meta property="og:url"         content="{{ site.url }}{{ page.url }}">
  <meta property="og:title"       content="{{ seo_title | default(title) }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:image"       content="{{ site.url }}/assets/og-image.png">
  <meta property="og:image:width"  content="1200">
  <meta property="og:image:height" content="630">
  {% if lang == 'nl' %}
  <meta property="og:locale"           content="nl_NL">
  <meta property="og:locale:alternate" content="en_US">
  {% else %}
  <meta property="og:locale"           content="en_US">
  <meta property="og:locale:alternate" content="nl_NL">
  {% endif %}

  <!-- Twitter / X card -->
  <meta name="twitter:card"        content="summary_large_image">
  <meta name="twitter:title"       content="{{ seo_title | default(title) }}">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image"       content="{{ site.url }}/assets/og-image.png">

  <!-- JSON-LD: HowTo structured data — Google deprecated HowTo rich results in 2023; still consumed by other search engines, voice assistants, and AI crawlers -->
  {% if howto_steps %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": {{ title | tojson | safe }},
    "description": {{ description | tojson | safe }},
    "step": [
      {% for step in howto_steps %}
      {
        "@type": "HowToStep",
        "position": {{ loop.index }},
        "name": {{ step.name | tojson | safe }},
        "text": {{ step.text | tojson | safe }}
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>
  {% endif %}

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' fill='%23D42B2B'/><text y='.85em' font-size='72' font-family='sans-serif' fill='white' font-weight='900' text-anchor='middle' x='50'>M</text></svg>">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800&family=Barlow:wght@400;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/assets/main.css">
</head>
<body>
  <div class="page-stripe" aria-hidden="true"></div>

  <header class="site-header">
    <div class="container">
      <div class="site-header__inner">
        <a href="/{{ lang | default('en') }}/" class="site-header__name">{{ brand | default('Meshcore Netherlands') }}</a>
        <div class="site-header__actions">
          <a href="https://assets.woodwar.com/meshcore_sf7_switch_instructions.pdf" target="_blank" rel="noopener" class="site-header__link">
            {{ nav_switch_link }} <span aria-hidden="true">↗</span>
          </a>
          <span class="site-header__sep" aria-hidden="true"></span>
          <nav class="lang-switcher" aria-label="{{ lang_switcher_aria_label }}">
            {% if lang == 'nl' %}
            <a href="/en/" class="lang-switcher__btn" lang="en" hreflang="en">EN</a>
            {% else %}
            <a href="/nl/" class="lang-switcher__btn" lang="nl" hreflang="nl">NL</a>
            {% endif %}
          </nav>
        </div>
      </div>
    </div>
  </header>

  <main class="site-main" id="main-content">
    <div class="container">
      <section class="hero">
        <h1 class="hero__title">{{ title | safe }}</h1>
        {% if description %}
        <p class="hero__desc">{{ description | safe }}</p>
        {% endif %}
      </section>
      {{ content | safe }}
    </div>
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="site-footer__inner">
        <p class="site-footer__text">{{ footer_community }}</p>
        <p class="site-footer__text">{{ footer_questions | safe }}</p>
      </div>
    </div>
  </footer>

  <script defer src="/assets/main.js"></script>
</body>
</html>
